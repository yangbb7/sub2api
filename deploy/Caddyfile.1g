{$DOMAIN} {
	encode zstd gzip

	@static {
		path /assets/*
		path /gateway-logo.svg
		path /logo.png
		path /favicon.ico
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy gateway:18080 {
		health_uri /health
		health_interval 30s
		health_timeout 10s
		header_up X-Real-IP {remote_host}
		header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
		transport http {
			keepalive 60s
			compression off
		}
	}

	request_body {
		max_size 100MB
	}

	log {
		output file /var/log/caddy/gateway.log {
			roll_size 10mb
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}
}
