# Copy this file to deploy/deploy-1g.env.local and fill real values.
# Do not commit the local file; it contains server and Cloudflare credentials.

# deploy: full deployment; preflight: remote checks only; build: build image on the VPS.
# DEPLOY_MODE=deploy

# Pick one when both Japan and Hong Kong servers are available: auto, jp, or hk.
# Leave empty to use SSH_TARGET directly.
TARGET_REGION=

# Direct target. Used when TARGET_REGION is empty.
SSH_TARGET=root@203.0.113.10
SSH_PORT=22
SSH_CONNECT_TIMEOUT=15

# Use exactly one auth method.
SSH_KEY=
SSH_PASSWORD=
# Alias for SSH_PASSWORD, matching some local ops skills.
SSH_PASS=
# auto: use root SSH when available, otherwise sudo; true: require sudo; false: require root SSH.
REMOTE_SUDO=auto
# Optional when SSH_TARGET is a non-root user and sudo needs a password.
# If empty, the deploy script tries SSH_PASSWORD/SSH_PASS as the sudo password.
SUDO_PASSWORD=

# Japan target. Used when TARGET_REGION=jp.
JP_SSH_TARGET=
JP_SSH_PORT=22
JP_SSH_KEY=
JP_SSH_PASSWORD=
JP_SSH_PASS=
JP_TARGET_IP=

# Hong Kong target. Used when TARGET_REGION=hk.
HK_SSH_TARGET=
HK_SSH_PORT=22
HK_SSH_KEY=
HK_SSH_PASSWORD=
HK_SSH_PASS=
HK_TARGET_IP=

# Full hostname managed by Cloudflare.
DOMAIN=api.example.com
TARGET_IP=203.0.113.10

# Cloudflare API token with Zone:Read and DNS:Edit on the target zone.
CF_API_TOKEN=
CF_ZONE_ID=
PROXIED=false
TTL=1
# Only set true when Cloudflare DNS already points this hostname at TARGET_IP.
SKIP_DNS=false
ROLLBACK_ON_FAILURE=true

# Remote install location.
REMOTE_DIR=/opt/gateway
SWAP_SIZE=2G
MIN_FREE_KB=3145728
MIN_DOCKER_FREE_KB=4194304
DOCKER_INSTALL_METHOD=auto

# Most Huana Cloud 1C1G VPS instances are x86_64.
PLATFORM=linux/amd64
GATEWAY_IMAGE=gateway:cloud
# Default for 1G servers: compile the linux binary locally, then let the VPS
# assemble a small runtime image. Set BUILD_STRATEGY=remote only for debugging.
BUILD_STRATEGY=local-binary
# Build-time limits for 1G servers.
BUILD_NODE_OPTIONS=--max-old-space-size=384
BUILD_GOMAXPROCS=1
LOCAL_BUILD_GOMAXPROCS=4
LOCAL_BUILD_GOMEMLIMIT=4GiB
LOCAL_BUILD_GCFLAGS=

# Runtime limits for deploy/deploy.sh blue-green gateway containers.
# Leave blank on 1C1G hosts to preserve the active container's Go runtime env
# and the default 256m container memory. On a 2C2G host, a typical setting is:
# GATEWAY_MEMORY_LIMIT=512m
# GATEWAY_GOMAXPROCS=2
# GATEWAY_GOMEMLIMIT=384MiB
GATEWAY_MEMORY_LIMIT=
GATEWAY_GOMAXPROCS=
GATEWAY_GOMEMLIMIT=

# Admin account. Leave ADMIN_PASSWORD empty to let the deploy script generate one.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional application settings.
TZ=Asia/Shanghai
ACME_EMAIL=
REDIS_PASSWORD=
UPDATE_PROXY_URL=
