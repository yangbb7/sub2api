# Copy this file to deploy/deploy-1g.env.local and fill the non-secret values.
# This template is for Huana Cloud 1C1G VPS instances. Fill the target IPs from
# your private ops notes or local SSH skill. Do not commit deploy/deploy-1g.env.local.
# Do not write SSH_PASS, SUDO_PASSWORD, or CF_API_TOKEN into this file. Export
# those secrets in the shell for the deploy command.

DEPLOY_MODE=deploy
# Default for 1G servers: compile the linux binary locally, then let the VPS
# assemble a small runtime image. Docker still runs on the selected VPS.
BUILD_STRATEGY=local-binary
TARGET_REGION=auto

# Japan and Hong Kong targets. Values below are documentation examples.
JP_SSH_TARGET=dhy@203.0.113.20
JP_SSH_PORT=22
JP_TARGET_IP=203.0.113.20

HK_SSH_TARGET=dhy@203.0.113.21
HK_SSH_PORT=22
HK_TARGET_IP=203.0.113.21

# Password auth. SSH_PASS is accepted as the shared password for both regions.
# If sudo uses a different password, export SUDO_PASSWORD too.
REMOTE_SUDO=auto

# Full hostname managed by Cloudflare, for example api.example.com.
DOMAIN=

# Cloudflare API token with Zone:Read and DNS:Edit on the target zone.
CF_ZONE_ID=
PROXIED=false
TTL=1
SKIP_DNS=false
ROLLBACK_ON_FAILURE=true

REMOTE_DIR=/opt/gateway
SWAP_SIZE=2G
MIN_FREE_KB=3145728
MIN_DOCKER_FREE_KB=4194304
DOCKER_INSTALL_METHOD=auto
PLATFORM=linux/amd64
GATEWAY_IMAGE=gateway:cloud
BUILD_NODE_OPTIONS=--max-old-space-size=1280
BUILD_GOMAXPROCS=1
LOCAL_BUILD_GOMAXPROCS=4
LOCAL_BUILD_GOMEMLIMIT=4GiB
LOCAL_BUILD_GCFLAGS=
PNPM_REGISTRY=https://registry.npmjs.org/

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

TZ=Asia/Shanghai
ACME_EMAIL=
REDIS_PASSWORD=
UPDATE_PROXY_URL=
